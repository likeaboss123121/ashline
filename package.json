{
  "name": "ashline",
  "version": "0.3.0",
  "private": true,
  "description": "Ashline, a SugarCube railway survival game",
  "scripts": {
    "build": "node scripts/build.cjs",
    "watch": "node scripts/build.cjs --watch",
    "world:build": "node scripts/world/compile-world.cjs",
    "world:check": "node scripts/world/compile-world.cjs --check",
    "world:benchmark": "node scripts/world/benchmark-world.cjs",
    "test": "node --test --test-concurrency=1 tests/core.test.cjs tests/review.test.cjs tests/migrations.test.cjs tests/world-graph.test.cjs tests/locales.test.cjs tests/variety.test.cjs tests/text-wiki.test.cjs",
    "test:browser": "node scripts/build.cjs && node --test tests/browser.test.cjs",
    "verify": "npm run build && npm test && npm run test:browser",
    "world:extract:south-america": "node scripts/world/run-limited.cjs scripts/world/extract-osm-rail.cjs",
    "world:extract:south-america:stations": "node scripts/world/run-limited.cjs scripts/world/extract-osm-stations.cjs",
    "world:route:south-america": "node scripts/world/run-limited.cjs scripts/world/route-planning-links.cjs",
    "world:extract:south-america:places": "node scripts/world/run-limited.cjs scripts/world/extract-osm-places.cjs",
    "world:extract:south-america:outposts": "node scripts/world/run-limited.cjs scripts/world/extract-osm-places.cjs --outposts",
    "world:network:south-america": "node scripts/world/run-limited.cjs scripts/world/build-network.cjs",
    "world:fetch:americas": "node scripts/world/fetch-osm-regions.cjs --output americas-filtered.osm.pbf central-america north-america/mexico north-america/canada north-america/us-pacific north-america/us-west north-america/us-midwest north-america/us-south north-america/us-northeast",
    "world:extract:americas": "node scripts/world/run-limited.cjs scripts/world/extract-osm-rail.cjs --scope americas",
    "world:extract:americas:stations": "node scripts/world/run-limited.cjs scripts/world/extract-osm-stations.cjs --scope americas",
    "world:extract:americas:places": "node scripts/world/run-limited.cjs scripts/world/extract-osm-places.cjs --scope americas",
    "world:extract:americas:outposts": "node scripts/world/run-limited.cjs scripts/world/extract-osm-places.cjs --scope americas --outposts",
    "world:network:americas": "node scripts/world/run-limited.cjs scripts/world/build-network.cjs --scope americas",
    "world:fetch:afro-eurasia": "node scripts/world/fetch-osm-regions.cjs --output afro-eurasia-filtered.osm.pbf europe asia russia africa",
    "world:extract:afro-eurasia": "node scripts/world/run-limited.cjs scripts/world/extract-osm-rail.cjs --scope afro-eurasia",
    "world:extract:afro-eurasia:stations": "node scripts/world/run-limited.cjs scripts/world/extract-osm-stations.cjs --scope afro-eurasia",
    "world:extract:afro-eurasia:places": "node scripts/world/run-limited.cjs scripts/world/extract-osm-places.cjs --scope afro-eurasia",
    "world:extract:afro-eurasia:outposts": "node scripts/world/run-limited.cjs scripts/world/extract-osm-places.cjs --scope afro-eurasia --outposts",
    "world:terrain-grid:afro-eurasia": "node scripts/world/run-limited.cjs scripts/world/terrain-grid.cjs --scope afro-eurasia --fetch",
    "world:network:afro-eurasia": "node scripts/world/run-limited.cjs scripts/world/build-network.cjs --scope afro-eurasia"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "any-ascii": "0.3.3",
    "playwright": "1.63.0"
  }
}
